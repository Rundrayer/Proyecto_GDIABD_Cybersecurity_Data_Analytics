# Carpetas ignoradas dentro de git para evitar subir arhivos generados durante la ejecucion

Datos/Cargados/*
Datos/Procesados/*
Datos/CSV_Generados/*
Datos/Implementacion_Gobernaza/*
Datos/Analiticos/Parquet/*
Datos/Analiticos/Resultados/*
Recursos/*
Datos/Modelos/*


# incluir archivo para mantener las carpetas vacias generadas dentro de la vista del repositorio
!Datos/Cargados/.gitkeep
!Datos/Procesados/.gitkeep
!Datos/CSV_Generados/.gitkeep
!Datos/Implementacion_Gobernanza/.gitkeep
!Datos/Analiticos/Parquet/.gitkeep
!Datos/Analiticos/Resultados/.gitkeep
!Recursos/.gitkeep
!Documentacion/.gitkeep
!Datos/Modelos/.gitkeep

# Para que git ignore archivos generados en la carga de trabajo
__pycache__/

*.exe
*.dll
*.md
*.xlsx
*.csv
*.parquet
*.parquet/
*.gz
*.rar
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.pkl
*.joblib

# Excepciones: Permitir que los reportes oficiales de la carpeta de documentación sí se suban a GitHub
!Datos/Implementacion_Gobernanza/*.md
!Datos/Implementacion_Gobernanza/*.xlsx
!Datos/Analiticos/Resultados/*.md
!Datos/Analiticos/Resultados/*.xlsx
!Datos/Reporteria/**
!Datos/Geoanalisis/**
!Documentacion/**

!README.md